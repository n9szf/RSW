// openings inside the tower: vestibule -> grand hall arches, trainmen's room door, 3rd-floor door, clock dials
module tower_inner_cuts() {
  for (xc = [150.5, 159.5, 168.5]) translate([0, 26, 0]) rotate([90, 0, 0]) linear_extrude(5)
      polygon(concat([[xc - 3.2, 4.0]], [for (a = [180 : -10 : 0]) [xc + 3.2 * cos(a), 14.0 + 3.2 * sin(a)]], [[xc + 3.2, 4.0]]));
  translate([157.85, 20.5, 23.5]) cube([3.3, 5, 9.6]);
  for (x = [TX0 - 1, TX1 - 4]) translate([x, 13, 0]) rotate([90, 0, 90]) linear_extrude(5)
      polygon(concat([[-3, 4.0], [3, 4.0]], [for (a = [0 : 10 : 180]) [3 * cos(a), 11.0 + 3 * sin(a)]]));
  translate([157.5, 20.5, 39.5]) cube([4, 5, 7.5]);
  for (y = [-3, 20.5]) translate([159.5, y + 5, 117.5]) rotate([90, 0, 0]) cylinder(r = 5.3, h = 5, $fn = 48);
  for (x = [TX0 - 1, TX1 - 4]) translate([x, 11.75, 115]) rotate([0, 90, 0]) cylinder(r = 3.2, h = 5, $fn = 40);
}
module dials() {
  for (y = [-1.2, 24.4]) translate([159.5, y + 0.2, 117.5]) rotate([90, 0, 0]) cylinder(r = 5.3, h = 0.2, $fn = 48);
  for (x = [TX0 + 0.3, TX1 - 0.5]) translate([x, 11.75, 115]) rotate([0, 90, 0]) cylinder(r = 3.2, h = 0.2, $fn = 40);
}
module hands() {   // 4:50 - hour and minute hands outside each dial; numerals as ticks
  for (f = [[0, -1.6, 1], [0, 25.4, -1]]) translate([159.5, f[1], 117.5]) rotate([90, 0, 0]) {
    rotate([0, 0, 90 - 145]) translate([0, -0.15, 0]) cube([2.8, 0.3, 0.12]);
    rotate([0, 0, 90 - 300]) translate([0, -0.1, 0]) cube([4.2, 0.2, 0.12]);
    for (i = [0 : 11]) rotate([0, 0, i * 30]) translate([4.4, -0.12, 0]) cube([0.7, 0.24, 0.1]);
    difference() { cylinder(r = 5.4, h = 0.1, $fn = 48); translate([0, 0, -1]) cylinder(r = 5.0, h = 3, $fn = 48); }
  }
  for (x = [TX0 - 0.15, TX1 + 0.05]) translate([x, 11.75, 115]) rotate([0, 90, 0]) {
    rotate([0, 0, -145]) translate([0, -0.1, 0]) cube([1.7, 0.2, 0.1]);
    rotate([0, 0, -300]) translate([0, -0.08, 0]) cube([2.6, 0.16, 0.1]);
  }
}
module all_cuts() { cut_N(); cut_S(); cut_E(); cut_W(); cut_PN(); cut_PS(); cut_TS(); cut_TE(); cut_TW(); tower_inner_cuts(); }
module ground() {
  hull() { translate([55, -90, -12]) cube([1, 360, 12]); translate([-220, -90, -12]) cube([1, 360, 3]); }
  translate([55, -90, -12]) cube([520, 360, 12]);
}
// ---------------- assembly by colour group ----------------
PART = "all";                // "all" or one group name, for per-colour STL export
U = 1;                       // 1 = feet (preview); 304.8 = millimetres for the Blender STL export
SHOW_GROUND = true;
module grp(name, c) if (PART == "all" || PART == name) color(c) children();
scale(U) {
  grp("r_brick", r_brick) difference() { render() union() { walls(); chimneys(); } render() union() { room_voids(0.5); voids(0); dormer_voids(); all_cuts(); } }
  grp("r_plaster", "#cdbb98") { difference() { render() room_voids(0.5); render() union() { room_voids(0); all_cuts(); } } int_r_plaster(); }
  grp("r_roof", r_roof) difference() { render() roofs(); render() union() { voids(0); dormer_voids(); cut_N(); cut_S(); cut_E(); cut_W(); cut_PN(); cut_PS(); } }
  grp("r_metal", r_metal) { metal(); hands(); int_r_metal(); }
  grp("r_glass", r_glass) { fill_N_glass(); fill_S_glass(); fill_E_glass(); fill_W_glass(); fill_PN_glass(); fill_PS_glass(); fill_TS_glass(); fill_TE_glass(); fill_TW_glass(); int_r_glass(); }
  grp("r_wood", r_wood) { fill_N_wood(); fill_S_wood(); fill_E_wood(); fill_W_wood(); fill_TS_wood(); fill_TE_wood(); fill_TW_wood(); int_r_wood(); }
  grp("r_floor", r_floor) int_r_floor();
  grp("r_stained", "#c8782a") int_r_stained();
  grp("r_stone", r_stone) int_r_stone();
  grp("r_frosted", "#dfe6e8") int_r_frosted();
  grp("r_gilt", "#c9a227") int_r_gilt();
  grp("r_lamp", "#fff1c8") int_r_lamp();
  grp("r_dial", r_white) dials();
  if (SHOW_GROUND) grp("r_ground", r_ground) ground();
}
