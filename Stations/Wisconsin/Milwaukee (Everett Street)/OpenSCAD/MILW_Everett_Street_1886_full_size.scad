module room_voids(g = 0) {
  translate([1.5 - g, 1.5 - g, -7.5]) cube([51.67 + 2 * g, 57 + 2 * g, 31]);
  translate([264.17 - g, 1.5 - g, -7.5]) cube([53.33 + 2 * g, 57 + 2 * g, 31]);
  difference() { translate([56.17 - g, 1.6 - g, -7.5]) cube([205 + 2 * g, 56.8 + 2 * g, 45.5]); translate([TX0 + g, -2, -9]) cube([TX1 - TX0 - 2 * g, 27 - g, 60]); }
  translate([TX0 + 3.2 - g, 1.7 - g, -7.5]) cube([TX1 - TX0 - 6.4 + 2 * g, 20.1 + 2 * g, 124]);
}
module voids(g = 0) {
  translate([1.5 - g, 1.5 - g, -7.5]) cube([51.67 + 2 * g, 57 + 2 * g, 31]);
  translate([264.17 - g, 1.5 - g, -7.5]) cube([53.33 + 2 * g, 57 + 2 * g, 31]);
  difference() { translate([56.17 - g, 1.6 - g, -7.5]) cube([205 + 2 * g, 56.8 + 2 * g, 45.5]); translate([TX0 + g, -2, -9]) cube([TX1 - TX0 - 2 * g, 27 - g, 60]); }
  translate([TX0 + 3.2 - g, 1.7 - g, -7.5]) cube([TX1 - TX0 - 6.4 + 2 * g, 20.1 + 2 * g, 124]);
  // main attic (3rd story) under the roof
  pts_hull([[56.17-g,1.6-g,38],[261.17+g,1.6-g,38],[56.17-g,58.4+g,38],[261.17+g,58.4+g,38],[56.17-g,1.6-g,43.5],[261.17+g,1.6-g,43.5],
            [56.17-g,55.5,44],[261.17+g,55.5,44],[64-g,10.2,60],[253+g,10.2,60],[64-g,49.8,60],[253+g,49.8,60]]);
  // end-block attics (2nd-floor end rooms with skylights)
  for (x = [[1.5, 53.17, 13, 53.17], [264.17, 317.5, 264.17, 306]])
    pts_hull([[x[0]-g,1.5-g,23.4],[x[1]+g,1.5-g,23.4],[x[0]-g,58.5+g,23.4],[x[1]+g,58.5+g,23.4],
