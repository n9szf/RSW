// plan outlines stacked up the height
module fnose_plan_solid(s) {
  ny = len(NOSE_Y); nz = len(NOSE_Z); n = 2*ny;
  pts = [for (k = [0:nz-1]) each concat(
           [for (j = [0:ny-1]) [ max(NOSE_HW[k][j], 0.02)*s, NOSE_YR[k][j]*s, NOSE_Z[k]*s]],
           [for (j = [ny-1:-1:0]) [-max(NOSE_HW[k][j], 0.02)*s, NOSE_YR[k][j]*s, NOSE_Z[k]*s]])];
  faces = concat([[for (i = [0:n-1]) i]],
                 [for (k = [0:nz-2]) for (i = [0:n-1]) each [[k*n+i, (k+1)*n+i, (k+1)*n+(i+1)%n], [k*n+i, (k+1)*n+(i+1)%n, k*n+(i+1)%n]]],
                 [[for (i = [n-1:-1:0]) (nz-1)*n+i]]);
  // bottom ring sits at the lowest waterline; pad it down to z = 0
  union() { polyhedron(pts, faces, convexity = 8);
            linear_extrude(NOSE_Z[0]*s + 0.01) polygon([for (p = [0:n-1]) [pts[p][0], pts[p][1]]]); }
}
// top surface as a height field (mirrored about the centreline)
module fnose_top_solid(s) {
  xs = concat([for (i = [len(NOSE_X)-1:-1:1]) -NOSE_X[i]], NOSE_X);
  zt = concat([for (i = [len(NOSE_X)-1:-1:1]) NOSE_ZT[i]], NOSE_ZT);
  nx = len(xs); ny = len(NOSE_Y);
  top = [for (i = [0:nx-1]) for (j = [0:ny-1]) [xs[i]*s, NOSE_Y[j]*s, max(zt[i][j], 0.05)*s]];
  bot = [for (i = [0:nx-1]) for (j = [0:ny-1]) [xs[i]*s, NOSE_Y[j]*s, -1]];
  T = function(i,j) i*ny+j;  B = function(i,j) nx*ny + i*ny+j;
  faces = concat(
    [for (i = [0:nx-2]) for (j = [0:ny-2]) each [[T(i,j), T(i,j+1), T(i+1,j+1)], [T(i,j), T(i+1,j+1), T(i+1,j)]]],
    [for (i = [0:nx-2]) for (j = [0:ny-2]) [B(i,j), B(i+1,j), B(i+1,j+1), B(i,j+1)]],
    [for (i = [0:nx-2]) each [[T(i,0), T(i+1,0), B(i+1,0)], [T(i,0), B(i+1,0), B(i,0)]]],
    [for (i = [0:nx-2]) each [[T(i,ny-1), B(i,ny-1), B(i+1,ny-1)], [T(i,ny-1), B(i+1,ny-1), T(i+1,ny-1)]]],
    [for (j = [0:ny-2]) each [[T(0,j), B(0,j), B(0,j+1)], [T(0,j), B(0,j+1), T(0,j+1)]]],
    [for (j = [0:ny-2]) each [[T(nx-1,j), T(nx-1,j+1), B(nx-1,j+1)], [T(nx-1,j), B(nx-1,j+1), B(nx-1,j)]]]);
  polyhedron(concat(top, bot), faces, convexity = 8);
}
// solid nose; s = model mm per prototype inch (G 25.4/29, O 25.4/48, HO 25.4/87.1)
module fnose_solid(s = 1) intersection() { fnose_plan_solid(s); fnose_top_solid(s); }
